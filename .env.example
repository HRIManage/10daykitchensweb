# Transactional email for the /bathroom-estimate lead form (Resend — resend.com).
# The free tier covers this. Without RESEND_API_KEY the estimator still works and
# shows estimates; it just does not email leads.
RESEND_API_KEY=re_your_key_here

# Optional. The "from" address for lead emails. Defaults to
# estimates@10daykitchens.com, which requires the domain to be verified in Resend.
# For testing before verification, set this to onboarding@resend.dev.
ESTIMATE_FROM_EMAIL=estimates@10daykitchens.com
